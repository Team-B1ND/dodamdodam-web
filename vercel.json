{
  "headers": [
    {
      "source": "/assets/(.+-[A-Za-z0-9_-]{8}\\.(?:js|css|woff2|woff|webp|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/"
    }
  ]
}
